# 默认本地开发；进程 APP_ENV 决定使用哪个配置文件。
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=luma_dev
DB_USER=postgres
DB_PASSWORD=
CORS_ORIGINS=["http://localhost:5173"]
# 本地不设置时使用进程临时签名密钥；不要填写空值。
# AUTH_SIGNING_KEY=使用 secrets.token_urlsafe(48) 生成
ACCESS_TOKEN_SECONDS=900
REFRESH_IDLE_SECONDS=604800
SESSION_MAX_SECONDS=2592000
